+// Apply row-level security to query results
+export function applyRowLevelSecurity<T>(
+  data: T[],
+  userId: number,
+  role: UserRole,
+  departments?: string[]
+): T[] {
+  // Fortune-50 compliant data filtering
+  if (['owner', 'admin', 'full'].includes(role)) {
+    return data; // Full access
+  }
+  
+  if (['supervisor', 'planning', 'accounting'].includes(role) && departments) {
+    // Department-level access
+    return data.filter((item: any) => {
+      if (item.departmentId) {
+        return departments.includes(item.departmentId);
+      }
+      if (item.department) {
+        return departments.includes(item.department);
+      }
+      return item.userId === userId; // Fallback to self
+    });
+  }
+  
+  // Default: self-only access
+  return data.filter((item: any) => {
+    if (item.userId) {
+      return item.userId === userId;
+    }
+    if (item.createdBy) {
+      return item.createdBy === userId;
+    }
+    return false; // Deny if no user association
+  });
+}