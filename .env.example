# STEELIQ Environment Configuration
# Copy this file to .env and fill in your values

# =====================================================
# REQUIRED CONFIGURATION
# =====================================================

# Database Configuration (Required)
# Get this from your Neon/PostgreSQL provider
DATABASE_URL=postgresql://user:password@host:port/database

# Session Configuration (Required)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret-here

# Environment (Required)
# Options: development, staging, production
NODE_ENV=development

# Application Configuration (Required)
PORT=5000
APP_NAME=STEELIQ
APP_URL=http://localhost:5000

# =====================================================
# AI CONFIGURATION (Required for AI features)
# =====================================================

# Anthropic Claude API (Required for AI estimation)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# =====================================================
# EMAIL CONFIGURATION (Optional but recommended)
# =====================================================

# SendGrid Configuration (For transactional emails)
# Get from: https://app.sendgrid.com
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=STEELIQ Platform

# Gmail OAuth Configuration (For invoice import)
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
# For local development:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# For production (update with your domain):
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# =====================================================
# SECURITY CONFIGURATION (Recommended)
# =====================================================

# Rate Limiting
# Window in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5000,http://localhost:3000

# Session Timeout (milliseconds)
# Default: 24 hours = 86400000
SESSION_TIMEOUT_MS=86400000

# Password Requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_UPPERCASE=true
REQUIRE_PASSWORD_NUMBERS=true
REQUIRE_PASSWORD_SPECIAL=true

# =====================================================
# LOGGING CONFIGURATION (Recommended)
# =====================================================

# Log Level
# Options: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Log Output
# Options: console, file, both
LOG_OUTPUT=both

# Log File Configuration (if LOG_OUTPUT includes 'file')
LOG_FILE_PATH=./logs/app.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_MAX_FILES=5

# =====================================================
# PRODUCTION MONITORING (Optional)
# =====================================================

# Default Defect Rate (as decimal, e.g., 0.02 = 2%)
# Used when real sensor data is not available
PRODUCTION_DEFECT_RATE=0.02

# Monitoring Interval (milliseconds)
# Default: 5 minutes = 300000
PRODUCTION_MONITORING_INTERVAL_MS=300000

# OEE Thresholds
OEE_AVAILABILITY_TARGET=0.90
OEE_PERFORMANCE_TARGET=0.95
OEE_QUALITY_TARGET=0.99

# =====================================================
# BUSINESS CONFIGURATION (Optional)
# =====================================================

# Cost Calculation Defaults
DEFAULT_OVERHEAD_PERCENTAGE=15
DEFAULT_PROFIT_MARGIN=20
DEFAULT_GST_RATE=0.15

# Material Pricing
DEFAULT_STEEL_PRICE_PER_KG=2.50
DEFAULT_COATING_PRICE_PER_SQM=45.00

# Labor Rates (if not in database)
DEFAULT_LABOR_RATE_PER_HOUR=85.00
DEFAULT_OVERTIME_MULTIPLIER=1.5

# =====================================================
# PERFORMANCE CONFIGURATION (Optional)
# =====================================================

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# AI Processing
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=5000

# File Upload Limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,dxf,dwg,csv,xlsx

# =====================================================
# MONITORING & OBSERVABILITY (Future)
# =====================================================

# DataDog APM (When implemented)
# DD_API_KEY=your-datadog-api-key
# DD_APP_KEY=your-datadog-app-key
# DD_SITE=datadoghq.com

# Sentry Error Tracking (When implemented)
# SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0

# =====================================================
# FEATURE FLAGS (Optional)
# =====================================================

# Enable/disable features
ENABLE_AI_ESTIMATION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PRODUCTION_MONITORING=true
ENABLE_COST_AGGREGATION=true
ENABLE_2FA=false

# =====================================================
# NOTES
# =====================================================
# 1. Never commit .env file to version control
# 2. Use strong, unique values for all secrets
# 3. Rotate secrets regularly (every 90 days)
# 4. Use different values for each environment
# 5. Document any custom environment variables here