# Google OAuth Configuration for Gmail Integration
# Get these from Google Cloud Console: https://console.cloud.google.com

# OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# OAuth 2.0 Client Secret from Google Cloud Console  
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Redirect URI (must match what's configured in Google Cloud Console)
# For local development:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# For Replit production deployment:
# GOOGLE_REDIRECT_URI=https://your-app-name.replit.app/api/auth/google/callback
# For custom domain (if you set one up):
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# Database URL (already configured)
DATABASE_URL=your-database-url